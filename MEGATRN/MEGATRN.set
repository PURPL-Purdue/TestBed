# General
in: {
	chamber_pressure = 200psi
		reason: Maintain allowable injector stiffness given TI constraints
		owner: Artem Smagin, asmagin@purdue.edu
	expansion_ratio = 2.704
		reason: Expand to ambient pressure ASL
		owner: Artem Smagin, asmagin@purdue.edu
	throat_diam = 5.271cm
		reason: ???
		owner: Artem Smagin, asmagin@purdue.edu
	chamber_id = 4.2in
		reason: Value within OD with an estimate of a heatsink wall
		owner: Artem Smagin, asmagin@purdue.edu
	chamber_od = 5.0in
		reason: Larger footprint then Maelstrom with common stock availability
		owner: Artem Smagin, asmagin@purdue.edu
}

# VAP
in: {
	mass_flow = 4.21 lb/s
		reason: Maximum within TI limits
		owner: Jacob Beveridge, jbeveri@purdue.edu
	of_ratio = 1.0
		reason: Minimize combustion temperature while still being within reasonable efficiency
		owner: Jacob Beveridge, jbeveri@purdue.edu
	oxidizer = "Liquid Oxygen"
		reason: Liquid oxidizer supported by TI
		owner: Jacob Beveridge, jbeveri@purdue.edu
	fuel = "Ethanol"
		reason: Less coking than RP-1
		owner: Jacob Beveridge, jbeveri@purdue.edu
	lox_stiffness = 20%
		reason: Maintain combustion stability
		owner: Jacob Beveridge, jbeveri@purdue.edu

	radial_discharge_coeff = 0.61
		reason: Standard Cd for sharp wall
		owner: Jacob Beveridge, jbeveri@purdue.edu
	annular_discharge_coeff = 0.98
		reason: Standard Cd for smooth transition
		owner: Jacob Beveridge, jbeveri@purdue.edu

	sleeve_thickness = 100thou
		reason: Manufacturing limit is 40thou, want to play it safe
		owner: Jacob Beveridge, jbeveri@purdue.edu
	pintle_wall = 100thou
		reason: Structural integrity and manufacturability
		owner: Jacob Beveridge, jbeveri@purdue.edu
	blockage_factor = 85%
		reason: Optimal based on literature (source lost)
		owner: Jacob Beveridge, jbeveri@purdue.edu
	mill_diameter = 40thou
		reason: Current BIDC tooling
		owner: Dominik Sloup, dsloup@purdue.edu
	friction_coeff = 0.8
		reason: ???
		owner: Jacob Beveridge, jbeveri@purdue.edu
	servo_encoder_count = 6400
		reason: Supplier spec. sheet
		owner: Jacob Beveridge, jbeveri@purdue.edu
	
	diam_ratio = 0.2
		reason: 1/3-5 recommended by (D. Escher, 1996)
		owner: Jacob Beveridge, jbeveri@purdue.edu
}
out: {
}


